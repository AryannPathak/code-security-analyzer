# SMARTFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as per your setup

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smartflow-super-secret-key-college-aiml-2026
JWT_SECRET_KEY=smartflow-jwt-token-secret-key-retail-9912
PORT=5000

# Database Configuration (MySQL)
# Default format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DB_USER=root
DB_PASSWORD=rootpassword
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartflow_db

# Complete SQLAlchemy connection string.
# Leave commented or empty to auto-build from DB_* variables above.
# If MySQL is not running locally, set to SQLite: sqlite:///smartflow.db
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/smartflow_db

# Fallback to SQLite if MySQL connection fails (Useful for quick local dev & testing)
USE_SQLITE_FALLBACK=True

# CORS Configuration (Frontend URL)
FRONTEND_URL=http://localhost:5173

# AIML Model Settings
MODEL_CACHE_DIR=./aiml/models
ANOMALY_CONTAMINATION=0.03
